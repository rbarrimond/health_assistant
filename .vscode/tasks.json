{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "func: host start (functions)",
			"command": "source ${workspaceFolder}/.venv/bin/activate && func host start --verbose",
			"problemMatcher": "$func-python-watch",
			"isBackground": true,
			"dependsOn": "pip install (functions)",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"languageWorkers__python__arguments": "-m debugpy --listen 127.0.0.1:9091 --wait-for-client"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "pip install (functions)",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/python -m pip install -e '.[dev]'",
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		}
	]
}